/skills/
/upload/
/agent-ctx/
/examples/
/download/
/mini-services/

# Runtime data — база данных SQLite (регенерируется из prisma db push)
/db/*.db
/db/*.db-journal

# Временные выходы скриптов
/scripts/output/

# Runtime files (local only)
.zscripts/dev.pid
tool-results/
